@using EduHome.Areas.Admin.ViewModels.Blog
@model BlogUpdateVM

<div class="Container">
    <form asp-area="admin" asp-action="update" method="post" enctype="multipart/form-data">
        <img style="width:100px; height:100px; object-fit:cover;" class="img-thumbnail" src="~/images/blog/@Model.ImageName" />
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="Title">Title</label>
            <input class="form-control" asp-for="Title" aria-describedby="emailHelp">
        </div>
        <div class="form-group">
            <label asp-for="Text">Text</label>
            <textarea class="form-control" asp-for="Text" aria-describedby="emailHelp"></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Image">Image</label>
            <input class="form-control" asp-for="Image" aria-describedby="emailHelp">
        </div>
        <a class="btn btn-secondary" asp-action="index">Cancel</a>
        <button type="submit" class="btn btn-primary">Update</button>
    </form>
</div>