@using EduHome.Areas.Admin.ViewModels.Blog
@model BlogCreateVM

<div class="Container">
    <form asp-area="admin" asp-action="create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="form-group mb-40">
            <label asp-for="CategoryId" class="form-group mb-2"> Category</label>
            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-control">
            <option value="">Choose</option>
            </select>
        </div>
        <div class="form-group">
            <label asp-for="Title">Title</label>
            <input class="form-control" asp-for="Title" aria-describedby="emailHelp">
        </div>
        
        <div class="form-group">
            <label asp-for="Text">Text</label>
            <textarea class="form-control" asp-for="Text" aria-describedby="emailHelp"></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Image">Image</label>
            <input class="form-control" asp-for="Image" aria-describedby="emailHelp">
        </div>
        <a class="btn btn-secondary" asp-action="index">Cancel</a>
        <button type="submit" class="btn btn-primary">Create</button>
    </form>
</div>
