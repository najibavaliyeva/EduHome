@model List<CourseGetVM>

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Kursların Siyahısı</h2>
        <a class="btn btn-primary" asp-action="Create">Create</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Title</th>
                    <th scope="col">Info</th>
                    <th scope="col">Image</th>
                    <th scope="col">Category</th>
                    <th scope="col">Skill Level</th>
                    <th scope="col">Class Duration</th>
                    <th scope="col">Duration (Month)</th>
                    <th scope="col">Description</th>
                    <th scope="col" class="text-center">Buttons</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <th scope="row">@item.Id</th>
                        <td>@item.Title</td>
                        <td>@item.Info</td>
                        <td>
                            <img style="width:100px; height:100px; object-fit:cover;" class="img-thumbnail" src="~/images/course/@item.Image" alt="@item.Title" />
                        </td>
                        <td>@item.CategoryId</td>
                        <td>@item.SkillLevel</td>
                        <td>@item.ClassDurationInHours saat</td>
                        <td>@item.DurationInMonth ay</td>
                        <td>
                            <!-- Mətn çox uzun olub cədvəli korlamasın deyə qısaldıldı -->
                            @(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center align-items-center gap-2">
                                <!-- Redaktə et (Update) -->
                                <a asp-action="update" asp-route-id="@item.Id" class="btn btn-sm btn-link p-0 text-warning" title="Redaktə et">
                                    <i class="fa-solid fa-pen-to-square fa-lg"></i>
                                </a>

                                <!-- Sil (Remove) -->
                                <form asp-action="remove" asp-route-id="@item.Id" method="post" class="m-0 d-inline" onsubmit="return confirm('Silmək istədiyinizdən əminsiniz?');">
                                    <button type="submit" class="btn btn-sm btn-link p-0 text-danger" title="Sil">
                                        <i class="fa-solid fa-trash-can fa-lg"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
